<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "RecipeBox" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-gray-50">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
        <%= link_to "RecipeBox", root_path, class: "text-xl font-bold text-emerald-600 tracking-tight" %>
        <div class="flex items-center gap-6">
          <%= link_to "Recipes", recipes_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
          <% if user_signed_in? %>
            <%= link_to "Meal Plan", my_meal_plan_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
            <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
            <%= link_to "Sign up", new_user_registration_path, class: "text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 px-4 py-2 rounded-lg transition-colors" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-4">
        <div class="rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-4">
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800"><%= alert %></div>
      </div>
    <% end %>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
