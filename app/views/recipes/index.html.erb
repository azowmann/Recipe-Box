<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-bold text-gray-900">Recipes</h1>
  <% if user_signed_in? %>
    <div class="flex gap-3">
      <%= link_to "My Meal Plan", my_meal_plan_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg px-4 py-2 transition-colors" %>
      <%= link_to "+ New Recipe", new_recipe_path, class: "text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg px-4 py-2 transition-colors" %>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
  <%= form_with url: recipes_path, method: :get, class: "flex gap-3" do |f| %>
    <%= f.text_field :ingredients,
        value: @ingredient_query,
        placeholder: "e.g. chicken, garlic, lemon",
        class: "flex-1 border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    <%= f.submit "Find Recipes", class: "bg-emerald-600 text-white text-sm font-medium px-5 py-2 rounded-lg hover:bg-emerald-700 cursor-pointer transition-colors" %>
    <% if @ingredient_query.present? %>
      <%= link_to "Clear", recipes_path, class: "text-sm text-gray-500 hover:text-gray-700 px-3 py-2 transition-colors" %>
    <% end %>
  <% end %>

  <% if @all_tags.any? %>
    <div class="mt-4 flex flex-wrap gap-2 items-center">
      <span class="text-xs text-gray-500 font-medium">Filter:</span>
      <%= link_to "All", recipes_path(ingredients: @ingredient_query.presence),
          class: "px-3 py-1 rounded-full text-xs font-medium transition-colors #{params[:tag].blank? ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% @all_tags.each do |tag| %>
        <%= link_to tag.name, recipes_path(tag: tag.name, ingredients: @ingredient_query.presence),
            class: "px-3 py-1 rounded-full text-xs font-medium transition-colors #{params[:tag] == tag.name ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% end %>
    </div>
  <% end %>
</div>

<% if @recipes.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @recipes.each do |recipe| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow">
        <h2 class="text-base font-semibold text-gray-900 mb-1">
          <%= link_to recipe.title, recipe_path(recipe), class: "hover:text-emerald-600 transition-colors" %>
        </h2>

        <% if @searched_names.present? %>
          <% recipe_ingredient_names = recipe.recipe_ingredients.map { |ri| ri.ingredient.name } %>
          <% matched = recipe_ingredient_names & @searched_names %>
          <% total = recipe.recipe_ingredients.size %>
          <p class="text-xs font-medium text-emerald-600 mb-2">
            <%= matched.size %> / <%= total %> ingredients matched
          </p>
        <% end %>

        <p class="text-xs text-gray-500 mt-2">
          <% parts = [] %>
          <% parts << "Prep #{recipe.prep_time} min" if recipe.prep_time %>
          <% parts << "Cook #{recipe.cook_time} min" if recipe.cook_time %>
          <% parts << "Serves #{recipe.servings}" if recipe.servings %>
          <%= parts.join(" · ") %>
        </p>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-20">
    <p class="text-gray-400 text-lg">
      <% if @ingredient_query.present? %>
        No recipes found with those ingredients.
      <% else %>
        No recipes yet.
      <% end %>
    </p>
  </div>
<% end %>
