<%= form_with model: recipe do |f| %>
  <% if recipe.errors.any? %>
    <div>
      <% recipe.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description, rows: 3 %>
  </div>

  <div>
    <%= f.label :instructions %>
    <%= f.text_area :instructions, rows: 8 %>
  </div>

  <div>
    <%= f.label :prep_time, "Prep time (minutes)" %>
    <%= f.number_field :prep_time, min: 1 %>
  </div>

  <div>
    <%= f.label :cook_time, "Cook time (minutes)" %>
    <%= f.number_field :cook_time, min: 1 %>
  </div>

  <div>
    <%= f.label :servings %>
    <%= f.number_field :servings, min: 1 %>
  </div>

  <div>
    <%= f.label :public, "Make this recipe public?" %>
    <%= f.check_box :public %>
  </div>

  <div>
    <%= f.label :tag_names, "Tags (comma-separated, e.g. vegetarian, quick, Italian)" %>
    <%= f.text_field :tag_names, value: recipe.tag_names %>
  </div>

  <div>
    <%= f.label :photo %>
    <%= f.file_field :photo, accept: "image/*" %>
  </div>

  <%= f.submit %>
<% end %>
