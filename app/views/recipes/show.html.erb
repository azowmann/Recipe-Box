<h1><%= @recipe.title %></h1>

<% if @recipe.photo.attached? %>
  <%= image_tag @recipe.photo, style: "max-width: 600px;" %>
<% end %>

<p><%= @recipe.description %></p>

<ul>
  <% if @recipe.prep_time %><li>Prep: <%= @recipe.prep_time %> min</li><% end %>
  <% if @recipe.cook_time %><li>Cook: <%= @recipe.cook_time %> min</li><% end %>
  <% if @recipe.servings %><li>Serves: <%= @recipe.servings %></li><% end %>
</ul>

<% if @recipe.recipe_ingredients.any? %>
  <h2>Ingredients</h2>
  <ul>
    <% @recipe.recipe_ingredients.includes(:ingredient).each do |ri| %>
      <li><%= ri.quantity %> <%= ri.unit %> <%= ri.ingredient.name %></li>
    <% end %>
  </ul>
<% end %>

<% if @recipe.tags.any? %>
  <p>
    <% @recipe.tags.each do |tag| %>
      <%= link_to tag.name, recipes_path(tag: tag.name) %>
    <% end %>
  </p>
<% end %>

<h2>Instructions</h2>
<%= simple_format @recipe.instructions %>

<% if user_signed_in? && @recipe.user == current_user %>
  <%= link_to "Edit", edit_recipe_path(@recipe) %>
  <%= button_to "Delete", recipe_path(@recipe), method: :delete, data: { turbo_confirm: "Delete this recipe?" } %>
<% end %>

<%= link_to "Back", recipes_path %>
