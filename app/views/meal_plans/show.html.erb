<h1>Meal Plan — Week of <%= @meal_plan.week_start_date.strftime("%B %d, %Y") %></h1>

<table>
  <thead>
    <tr>
      <th>Day</th>
      <% MealPlanEntry::MEAL_TYPES.each do |meal| %>
        <th><%= meal.capitalize %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% MealPlan::DAYS.each_with_index do |day, index| %>
      <tr>
        <td><strong><%= day %></strong></td>
        <% MealPlanEntry::MEAL_TYPES.each do |meal_type| %>
          <td>
            <% entry = @entries[[index, meal_type]] %>
            <% if entry %>
              <%= entry.recipe.title %>
              <%= button_to "Remove",
                  meal_plan_meal_plan_entry_path(@meal_plan, entry),
                  method: :delete,
                  data: { turbo_confirm: "Remove this meal?" } %>
            <% else %>
              <%= form_with url: meal_plan_meal_plan_entries_path(@meal_plan) do |f| %>
                <%= f.hidden_field :day_of_week, value: index %>
                <%= f.hidden_field :meal_type, value: meal_type %>
                <%= f.select :recipe_id,
                    @recipes.map { |r| [r.title, r.id] },
                    { include_blank: "— pick a recipe —" } %>
                <%= f.submit "Add" %>
              <% end %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Shopping List", meal_plan_shopping_list_path(@meal_plan) %>
<%= link_to "Back", recipes_path %>
